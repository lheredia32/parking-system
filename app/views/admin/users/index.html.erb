<div class="container mx-auto p-6">
  <!-- Reloj digital estilo retro-futurista -->
  <div class="flex justify-center mb-4">
    <div id="digital-clock-users" class="font-mono text-5xl tracking-widest text-cyan-400 bg-gray-900 px-8 py-4 rounded-xl border-2 border-cyan-500/50 shadow-lg shadow-cyan-500/20 relative overflow-hidden">
      <span class="relative z-10">--:--:--</span>
      <div class="absolute inset-0 bg-gradient-to-r from-cyan-500/10 to-transparent"></div>
    </div>
  </div>

  <!-- Fecha -->
  <div class="text-center mb-6">
    <p id="current-date-users" class="text-lg text-gray-400 font-light tracking-widest uppercase"></p>
  </div>

  <h1 class="text-5xl font-bold text-center text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-500 to-purple-500 mb-2" style="font-family: 'Orbitron', sans-serif;">
    <i class="fa fa-users"></i> GESTIÓN DE USUARIOS
  </h1>

  <p class="text-center text-cyan-400/80 mb-6">
    <span class="text-white/60">Administrador:</span>
    <%= link_to Current.user.email_address, profile_path, class: "text-cyan-400 hover:text-cyan-300 transition-colors" %>
  </p>

  <div class="flex justify-between items-center mb-6">
    <%= link_to vehicles_path, class: "bg-gray-600 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded-lg transition transform hover:scale-105" do %>
      <i class="fa-solid fa-backward-step"></i> Volver
    <% end %>
    <span class="text-gray-400">Total: <%= @users.count %> usuario(s)</span>
  </div>

  <div class="w-full bg-gray-800 p-6 rounded-lg shadow-lg border border-cyan-500/30">
    <% if @users.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full bg-gray-800 text-gray-300 rounded-lg shadow-md overflow-hidden border border-cyan-500/30">
          <thead class="bg-gradient-to-r from-gray-700 to-gray-600">
            <tr>
              <th class="px-4 py-3 text-center text-sm font-semibold tracking-wider text-cyan-400">#</th>
              <th class="px-4 py-3 text-center text-sm font-semibold tracking-wider text-cyan-400">Email</th>
              <th class="px-4 py-3 text-center text-sm font-semibold tracking-wider text-cyan-400">Nombre</th>
              <th class="px-4 py-3 text-center text-sm font-semibold tracking-wider text-cyan-400">Teléfono</th>
              <th class="px-4 py-3 text-center text-sm font-semibold tracking-wider text-cyan-400">Vehículos</th>
              <th class="px-4 py-3 text-center text-sm font-semibold tracking-wider text-cyan-400">Rol</th>
              <th class="px-4 py-3 text-center text-sm font-semibold tracking-wider text-cyan-400">Creado</th>
              <th class="px-4 py-3 text-center text-sm font-semibold tracking-wider text-cyan-400">Acciones</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-700">
            <% @users.each_with_index do |user, index| %>
              <tr class="hover:bg-gray-700/50 transition-all duration-200">
                <td class="px-4 py-3 text-center font-mono text-cyan-500"><%= index + 1 %></td>
                <td class="px-4 py-3 text-center font-bold text-white"><%= user.email_address %></td>
                <td class="px-4 py-3 text-center text-gray-300"><%= user.profile&.name || '—' %> <%= user.profile&.last_name || '' %></td>
                <td class="px-4 py-3 text-center font-mono text-gray-400"><%= user.profile&.phone_number || '—' %></td>
                <td class="px-4 py-3 text-center">
                  <span class="bg-purple-500/20 text-purple-300 px-2 py-1 rounded text-xs">
                    <%= user.vehicles.count %>
                  </span>
                </td>
                <td class="px-4 py-3 text-center">
                  <% if user.admin? %>
                    <span class="bg-purple-500/20 text-purple-300 px-2 py-1 rounded text-xs font-bold">Admin</span>
                  <% else %>
                    <span class="bg-blue-500/20 text-blue-300 px-2 py-1 rounded text-xs">Empleado</span>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-center font-mono text-gray-400 text-xs"><%= user.created_at.strftime("%Y-%m-%d") %></td>
                <td class="px-4 py-3 text-center">
                  <% if user == Current.user %>
                    <span class="text-gray-500 text-xs">Tú</span>
                  <% else %>
                    <%= link_to edit_admin_user_path(user), class: "bg-cyan-500 hover:bg-cyan-600 text-white font-bold py-1 px-3 rounded-lg transition transform hover:scale-105 inline-block" do %>
                      <i class="fa fa-edit"></i>
                    <% end %>
                    <%= button_to admin_user_path(user), method: :delete, data: { confirm: "¿Eliminar usuario #{user.email_address}? Esta acción no se puede deshacer." }, class: "bg-red-500 hover:bg-red-600 text-white font-bold py-1 px-3 rounded-lg transition transform hover:scale-105 inline-block ml-2" do %>
                      <i class="fa fa-trash"></i>
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-12 bg-gray-800/50 rounded-lg border border-dashed border-gray-700">
        <i class="fa fa-users text-4xl text-gray-600 mb-4"></i>
        <p class="text-gray-500 text-lg">No hay usuarios registrados.</p>
      </div>
    <% end %>
  </div>

  <footer class="text-xs text-white text-center py-2 mt-8">
    &lt;/&gt; by Heredium
  </footer>
</div>

<script>
  function updateClockUsers() {
    const now = new Date();
    const hours = String(now.getHours()).padStart(2, '0');
    const minutes = String(now.getMinutes()).padStart(2, '0');
    const seconds = String(now.getSeconds()).padStart(2, '0');
    const timeString = `${hours}:${minutes}:${seconds}`;

    const clockElement = document.getElementById('digital-clock-users');
    if (clockElement) {
      clockElement.querySelector('span').textContent = timeString;
      if (parseInt(seconds) % 2 === 0) {
        clockElement.classList.add('opacity-90');
      } else {
        clockElement.classList.remove('opacity-90');
      }
    }

    const dateElement = document.getElementById('current-date-users');
    if (dateElement) {
      const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
      dateElement.textContent = now.toLocaleDateString('es-CO', options);
    }
  }

  updateClockUsers();
  setInterval(updateClockUsers, 1000);
</script>