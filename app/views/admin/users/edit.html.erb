<div class="container mx-auto p-6">
  <!-- Reloj digital -->
  <div class="flex justify-center mb-4">
    <div id="digital-clock-edit-user" class="font-mono text-4xl tracking-widest text-cyan-400 bg-gray-900 px-6 py-3 rounded-xl border-2 border-cyan-500/50 shadow-lg shadow-cyan-500/20">
      <span class="relative z-10">--:--:--</span>
    </div>
  </div>

  <h1 class="text-4xl font-bold text-center text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-500 to-purple-500 mb-6" style="font-family: 'Orbitron', sans-serif;">
    <i class="fa fa-user-cog"></i> EDITAR USUARIO
  </h1>

  <div class="max-w-2xl mx-auto bg-gray-800 p-8 rounded-lg shadow-lg border border-cyan-500/30">
    <div class="mb-6 p-4 bg-gray-700/50 rounded-lg">
      <p class="text-gray-400 text-sm">Email</p>
      <p class="text-white text-xl font-bold"><%= @user.email_address %></p>
    </div>

    <div class="mb-6 p-4 bg-gray-700/50 rounded-lg">
      <p class="text-gray-400 text-sm">Nombre</p>
      <p class="text-white text-lg"><%= @user.profile&.name || '—' %> <%= @user.profile&.last_name || '' %></p>
    </div>

    <div class="mb-6 p-4 bg-gray-700/50 rounded-lg">
      <p class="text-gray-400 text-sm">Vehículos registrados</p>
      <p class="text-white text-lg"><%= @user.vehicles.count %></p>
    </div>

    <%= form_with model: [:admin, @user], local: true, class: "space-y-6" do |f| %>
      <div>
        <label class="block text-cyan-400 text-sm font-bold mb-2">Rol del Usuario</label>
        <div class="flex space-x-4">
          <label class="flex items-center bg-gray-700 p-4 rounded-lg cursor-pointer hover:bg-gray-600 transition flex-1 <%= @user.empleado? ? 'ring-2 ring-green-500' : '' %>">
            <%= f.radio_button :role, :empleado, class: "w-4 h-4 text-green-500" %>
            <span class="ml-3 text-white font-semibold">Empleado</span>
          </label>
          <label class="flex items-center bg-gray-700 p-4 rounded-lg cursor-pointer hover:bg-gray-600 transition flex-1 <%= @user.admin? ? 'ring-2 ring-red-500' : '' %>">
            <%= f.radio_button :role, :admin, class: "w-4 h-4 text-red-500" %>
            <span class="ml-3 text-white font-semibold">Administrador</span>
          </label>
        </div>
      </div>

      <div class="flex justify-between pt-4">
        <%= link_to admin_users_path, class: "bg-gray-600 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded-lg transition transform hover:scale-105" do %>
          <i class="fa-solid fa-backward-step"></i> Volver
        <% end %>
        <%= f.submit "Guardar Cambios", class: "bg-green-500 hover:bg-green-600 text-white font-bold py-2 px-6 rounded-lg transition transform hover:scale-105" %>
      </div>
    <% end %>
  </div>

  <footer class="text-xs text-white text-center py-2 mt-8">
    &lt;/&gt; by Heredium
  </footer>
</div>

<script>
  function updateClockEditUser() {
    const now = new Date();
    const hours = String(now.getHours()).padStart(2, '0');
    const minutes = String(now.getMinutes()).padStart(2, '0');
    const seconds = String(now.getSeconds()).padStart(2, '0');
    const clockElement = document.getElementById('digital-clock-edit-user');
    if (clockElement) {
      clockElement.querySelector('span').textContent = `${hours}:${minutes}:${seconds}`;
    }
  }
  updateClockEditUser();
  setInterval(updateClockEditUser, 1000);
</script>