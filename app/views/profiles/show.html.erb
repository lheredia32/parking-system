<div class="container mx-auto p-6">
  <!-- Reloj digital estilo retro-futurista -->
  <div class="flex justify-center mb-4">
    <div id="digital-clock-profile" class="font-mono text-5xl tracking-widest text-cyan-400 bg-gray-900 px-8 py-4 rounded-xl border-2 border-cyan-500/50 shadow-lg shadow-cyan-500/20 relative overflow-hidden">
      <span class="relative z-10">--:--:--</span>
      <div class="absolute inset-0 bg-gradient-to-r from-cyan-500/10 to-transparent"></div>
    </div>
  </div>

  <!-- Fecha -->
  <div class="text-center mb-6">
    <p id="current-date-profile" class="text-lg text-gray-400 font-light tracking-widest uppercase"></p>
  </div>

  <h1 class="text-5xl font-bold text-center text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-500 to-purple-500 mb-6" style="font-family: 'Orbitron', sans-serif;">
    <i class="fa fa-user"></i> PERFIL
  </h1>

  <div class="max-w-2xl mx-auto">
    <div class="bg-gray-800 p-6 rounded-lg shadow-lg border border-cyan-500/30">
      <table class="min-w-full text-gray-300 mb-6">
        <tbody class="divide-y divide-gray-700">
          <tr>
            <td class="px-4 py-3 font-semibold text-cyan-400">Nombre:</td>
            <td class="px-4 py-3 text-white"><%= @profile.name || 'No registrado' %></td>
          </tr>
          <tr>
            <td class="px-4 py-3 font-semibold text-cyan-400">Apellido:</td>
            <td class="px-4 py-3 text-white"><%= @profile.last_name || 'No registrado' %></td>
          </tr>
          <tr>
            <td class="px-4 py-3 font-semibold text-cyan-400">Correo:</td>
            <td class="px-4 py-3 text-white"><%= Current.user.email_address %></td>
          </tr>
          <tr>
            <td class="px-4 py-3 font-semibold text-cyan-400">Teléfono:</td>
            <td class="px-4 py-3 text-white"><%= @profile.phone_number || 'No registrado' %></td>
          </tr>
          <tr>
            <td class="px-4 py-3 font-semibold text-cyan-400">Rol:</td>
            <td class="px-4 py-3">
              <% if Current.user.admin? %>
                <span class="bg-purple-500/20 text-purple-300 px-3 py-1 rounded-full text-sm">
                  <i class="fa fa-shield"></i> Administrador
                </span>
              <% else %>
                <span class="bg-green-500/20 text-green-300 px-3 py-1 rounded-full text-sm">
                  <i class="fa fa-user"></i> Empleado
                </span>
              <% end %>
            </td>
          </tr>
          <tr>
            <td class="px-4 py-3 font-semibold text-cyan-400">Días en el sistema:</td>
            <td class="px-4 py-3 text-white font-mono"><%= (Current.user.created_at.to_date..Date.today).count %></td>
          </tr>
        </tbody>
      </table>

      <div class="flex justify-center space-x-4">
        <%= link_to edit_profile_path(@profile), class: "bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded-lg transition transform hover:scale-105" do %>
          <i class="fa fa-edit"></i> Editar Perfil
        <% end %>
        <%= link_to vehicles_path, class: "bg-gray-600 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded-lg transition transform hover:scale-105" do %>
          <i class="fa-solid fa-backward-step"></i> Volver
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
  function updateClockProfile() {
    const now = new Date();
    const hours = String(now.getHours()).padStart(2, '0');
    const minutes = String(now.getMinutes()).padStart(2, '0');
    const seconds = String(now.getSeconds()).padStart(2, '0');
    const timeString = `${hours}:${minutes}:${seconds}`;

    const clockElement = document.getElementById('digital-clock-profile');
    if (clockElement) {
      clockElement.querySelector('span').textContent = timeString;

      if (parseInt(seconds) % 2 === 0) {
        clockElement.classList.add('opacity-90');
      } else {
        clockElement.classList.remove('opacity-90');
      }

      const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
      const dateString = now.toLocaleDateString('es-CO', options);
      const dateElement = document.getElementById('current-date-profile');
      if (dateElement) dateElement.textContent = dateString;
    }
  }

  updateClockProfile();
  setInterval(updateClockProfile, 1000);
</script>
