<div class="container mx-auto p-6">
  <!-- Reloj digital estilo retro-futurista -->
  <div class="flex justify-center mb-4">
    <div id="digital-clock" class="font-mono text-5xl tracking-widest text-cyan-400 bg-gray-900 px-8 py-4 rounded-xl border-2 border-cyan-500/50 shadow-lg shadow-cyan-500/20 relative overflow-hidden">
      <span class="relative z-10">--:--:--</span>
      <div class="absolute inset-0 bg-gradient-to-r from-cyan-500/10 to-transparent"></div>
    </div>
  </div>

  <!-- Fecha -->
  <div class="text-center mb-6">
    <p id="current-date" class="text-lg text-gray-400 font-light tracking-widest uppercase"></p>
  </div>

  <h1 class="text-5xl font-bold text-center text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-500 to-purple-500 mb-6" style="font-family: 'Orbitron', sans-serif;">
    <i class="fa fa-car"></i> PARKING
  </h1>

  <div class="flex justify-center space-x-8 mb-8">
    <!-- Formulario de registro de vehículo -->
    <div class="w-1/3 bg-gray-800 p-6 rounded-lg shadow-lg">
      <h2 class="text-2xl font-semibold text-center text-cyan-300 mb-4" style="font-family: 'Orbitron', sans-serif;">Registro de Ingreso</h2>

      <%= form_with model: Vehicle.new, url: vehicles_path, local: true, class: "space-y-4", data: { turbo_frame: "vehicles-frame" }, id: "vehicle-form" do |form| %>
        <div>
          <%= form.label :plate_number, "Número de Placa:", class: "block text-sm font-medium text-blue-300" %>
          <%= form.text_field :plate_number, required: true, class: "w-full mt-1 p-2 rounded-md bg-gray-700 text-white focus:ring-2 focus:ring-blue-500 focus:outline-none" %>
        </div>
        <div>
          <%= form.label :vehicle_type, "Tipo de Vehículo:", class: "block text-sm font-medium text-blue-300" %>
          <%= form.select :vehicle_type, Vehicle.vehicle_types.keys.map { |type| [type.humanize, type] }, { prompt: 'Seleccione el tipo de vehículo' }, class: "w-full mt-1 p-2 rounded-md bg-gray-700 text-white focus:ring-2 focus:ring-blue-500 focus:outline-none" %>
        </div>
        <div class="flex justify-center">
          <%= form.submit "Registrar", class: "bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded-lg transition transform hover:scale-105" %>
        </div>
      <% end %>
    </div>

    <!-- Tabla de tarifas -->
    <div class="w-1/3 bg-gray-800 p-6 rounded-lg shadow-lg">
      <h2 class="text-2xl font-semibold text-center text-cyan-300 mb-4" style="font-family: 'Orbitron', sans-serif;">Tarifas</h2>
      <table class="min-w-full bg-gray-700 text-gray-300 rounded-lg shadow-md overflow-hidden">
        <thead class="bg-gray-600">
          <tr>
            <th class="px-4 py-2 text-left text-sm font-semibold tracking-wider">Tipo de Vehículo</th>
            <th class="px-4 py-2 text-left text-sm font-semibold tracking-wider">Tarifa</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-600">
          <tr>
            <td class="px-4 py-2">Motocicleta</td>
            <td class="px-4 py-2">$3500/hora o fracción</td>
          </tr>
          <tr>
            <td class="px-4 py-2">Carro</td>
            <td class="px-4 py-2">$5000/hora o fracción</td>
          </tr>
          <tr>
            <td class="px-4 py-2">Bicicleta</td>
            <td class="px-4 py-2">$2500/día</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Cuadro de botones -->
    <div class="w-1/3 bg-gray-800 p-6 rounded-lg shadow-lg">
      <h2 class="text-2xl font-semibold text-center text-cyan-300 mb-4" style="font-family: 'Orbitron', sans-serif;">Acciones</h2>
      <div class="flex flex-col items-center space-y-4">
        <button
          type="button"
          class="bg-green-500 hover:bg-green-600 text-white font-bold py-2 px-4 rounded-lg transition transform hover:scale-105 w-48"
          onclick="toggleModal('search-modal')">
          <i class="fa fa-search"></i> Buscar por Placa
        </button>
        <% if Current.user.admin? %>
          <%= link_to records_by_user_vehicles_path, class: "text-center bg-yellow-500 hover:bg-yellow-600 text-white font-bold py-2 px-4 rounded-lg transition transform hover:scale-105 w-48" do %>
            <i class="fa fa-list"></i> Ver Registros
          <% end %>
        <% end %>
        <%= link_to profile_path, class: "text-center bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded-lg transition transform hover:scale-105 w-48" do %>
          <i class="fa fa-user"></i> Perfil
        <% end %>
      </div>
    </div>
  </div>

  <!-- Tabla de vehículos en parqueadero - solo se muestra si hay vehículos -->
  <% if @vehicles_in_parking.any? %>
    <div class="mt-8">
      <h2 class="text-2xl font-semibold text-center text-cyan-300 mb-4 flex items-center justify-center gap-2" style="font-family: 'Orbitron', sans-serif;">
        <i class="fa fa-parking"></i> Vehículos en Parqueadero
        <span class="bg-cyan-500/20 text-cyan-300 text-sm px-3 py-1 rounded-full"><%= @vehicles_in_parking.count %></span>
      </h2>
      <div class="overflow-x-auto">
        <turbo-frame id="vehicles-frame">
          <table class="min-w-full bg-gray-800 text-gray-300 rounded-lg shadow-md overflow-hidden border border-cyan-500/30">
            <thead class="bg-gradient-to-r from-gray-700 to-gray-600">
              <tr>
                <th class="px-4 py-3 text-center text-sm font-semibold tracking-wider text-cyan-400">#</th>
                <th class="px-4 py-3 text-center text-sm font-semibold tracking-wider text-cyan-400">Placa</th>
                <th class="px-4 py-3 text-center text-sm font-semibold tracking-wider text-cyan-400">Tipo</th>
                <th class="px-4 py-3 text-center text-sm font-semibold tracking-wider text-cyan-400">Fecha</th>
                <th class="px-4 py-3 text-center text-sm font-semibold tracking-wider text-cyan-400">Entrada</th>
                <th class="px-4 py-3 text-center text-sm font-semibold tracking-wider text-cyan-400">Acciones</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-700">
              <% @vehicles_in_parking.each_with_index do |vehicle, index| %>
                <tr class="hover:bg-gray-700/50 transition-all duration-200 hover:scale-[1.01]">
                  <td class="px-4 py-3 text-center font-mono text-cyan-500"><%= index + 1 %></td>
                  <td class="px-4 py-3 text-center font-bold text-white"><%= vehicle.plate_number.upcase %></td>
                  <td class="px-4 py-3 text-center">
                    <% case vehicle.vehicle_type
                       when 'Carro' %>
                      <span class="bg-blue-500/20 text-blue-300 px-2 py-1 rounded text-xs">Carro</span>
                    <% when 'Motocicleta' %>
                      <span class="bg-orange-500/20 text-orange-300 px-2 py-1 rounded text-xs">Motocicleta</span>
                    <% when 'Bicicleta' %>
                      <span class="bg-green-500/20 text-green-300 px-2 py-1 rounded text-xs">Bicicleta</span>
                    <% else %>
                      <span class="bg-gray-600 px-2 py-1 rounded text-xs"><%= vehicle.vehicle_type %></span>
                    <% end %>
                  </td>
                  <td class="px-4 py-3 text-center font-mono text-gray-400"><%= vehicle.entry_time.strftime("%Y-%m-%d") %></td>
                  <td class="px-4 py-3 text-center font-mono text-green-400"><%= vehicle.entry_time.strftime("%I:%M %p") %></td>
                  <td class="px-4 py-3 text-center">
                    <%= button_to exit_vehicle_path(vehicle), method: :patch, class: "bg-red-500 hover:bg-red-600 text-white font-bold py-1 px-3 rounded-lg transition transform hover:scale-105" do %>
                      <i class="fa fa-sign-out-alt"></i> Salida
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </turbo-frame>
      </div>
    </div>
  <% else %>
    <div class="mt-8 text-center py-12 bg-gray-800/50 rounded-lg border border-dashed border-gray-700">
      <i class="fa fa-car text-6xl text-gray-600 mb-4"></i>
      <p class="text-gray-500 text-lg">No hay vehículos en el parqueadero</p>
    </div>
  <% end %>

  <!-- Tabla de últimos 5 registros de salida - solo se muestra si hay registros -->
  <% if @recent_exits.any? %>
    <div class="mb-8 mt-8">
      <h2 class="text-2xl font-semibold text-center text-cyan-300 mb-4 flex items-center justify-center gap-2" style="font-family: 'Orbitron', sans-serif;">
        <i class="fa fa-history"></i> Últimos Registros de Salida
        <span class="bg-purple-500/20 text-purple-300 text-sm px-3 py-1 rounded-full"><%= @recent_exits.count %></span>
      </h2>
      <div class="overflow-x-auto">
        <turbo-frame id="recent-exits-frame">
          <table class="min-w-full bg-gray-800 text-gray-300 rounded-lg shadow-md overflow-hidden border border-purple-500/30">
            <thead class="bg-gradient-to-r from-gray-700 to-gray-600">
              <tr>
                <th class="px-4 py-3 text-center text-sm font-semibold tracking-wider text-purple-400">#</th>
                <th class="px-4 py-3 text-center text-sm font-semibold tracking-wider text-purple-400">Placa</th>
                <th class="px-4 py-3 text-center text-sm font-semibold tracking-wider text-purple-400">Tipo</th>
                <th class="px-4 py-3 text-center text-sm font-semibold tracking-wider text-purple-400">Fecha</th>
                <th class="px-4 py-3 text-center text-sm font-semibold tracking-wider text-purple-400">Entrada</th>
                <th class="px-4 py-3 text-center text-sm font-semibold tracking-wider text-purple-400">Salida</th>
                <th class="px-4 py-3 text-center text-sm font-semibold tracking-wider text-purple-400">Tiempo</th>
                <th class="px-4 py-3 text-center text-sm font-semibold tracking-wider text-purple-400">Costo</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-700">
              <% @recent_exits.each_with_index do |vehicle, index| %>
                <tr class="hover:bg-gray-700/50 transition-all duration-200">
                  <td class="px-4 py-3 text-center font-mono text-purple-500"><%= index + 1 %></td>
                  <td class="px-4 py-3 text-center font-bold text-white"><%= vehicle.plate_number.upcase %></td>
                  <td class="px-4 py-3 text-center">
                    <% case vehicle.vehicle_type
                       when 'Carro' %>
                      <span class="bg-blue-500/20 text-blue-300 px-2 py-1 rounded text-xs">Carro</span>
                    <% when 'Motocicleta' %>
                      <span class="bg-orange-500/20 text-orange-300 px-2 py-1 rounded text-xs">Motocicleta</span>
                    <% when 'Bicicleta' %>
                      <span class="bg-green-500/20 text-green-300 px-2 py-1 rounded text-xs">Bicicleta</span>
                    <% else %>
                      <span class="bg-gray-600 px-2 py-1 rounded text-xs"><%= vehicle.vehicle_type %></span>
                    <% end %>
                  </td>
                  <td class="px-4 py-3 text-center font-mono text-gray-400"><%= vehicle.entry_time.strftime("%Y-%m-%d") %></td>
                  <td class="px-4 py-3 text-center font-mono text-gray-400"><%= vehicle.entry_time.strftime("%I:%M %p") %></td>
                  <td class="px-4 py-3 text-center font-mono text-red-400"><%= vehicle.exit_time.strftime("%I:%M %p") %></td>
                  <td class="px-4 py-3 text-center font-mono text-yellow-400"><%= vehicle.total_time %></td>
                  <td class="px-4 py-3 text-center font-bold text-green-400"><%= number_to_currency(vehicle.total_cost, unit: "$", precision: 0) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </turbo-frame>
      </div>
    </div>
  <% end %>
  <footer class="text-xs text-white text-center py-2">
    &lt;/&gt; by Heredium
  </footer>
</div>

<script>
  // Reloj digital en tiempo real - estilo retro-futurista
  function updateClock() {
    const now = new Date();
    const hours = String(now.getHours()).padStart(2, '0');
    const minutes = String(now.getMinutes()).padStart(2, '0');
    const seconds = String(now.getSeconds()).padStart(2, '0');
    const timeString = `${hours}:${minutes}:${seconds}`;
    
    const clockElement = document.getElementById('digital-clock');
    clockElement.querySelector('span').textContent = timeString;
    
    // Efecto de parpadeo cada segundo
    if (parseInt(seconds) % 2 === 0) {
      clockElement.classList.add('opacity-90');
    } else {
      clockElement.classList.remove('opacity-90');
    }
    
    // Fecha
    const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
    const dateString = now.toLocaleDateString('es-CO', options);
    document.getElementById('current-date').textContent = dateString;
  }
  
  // Actualizar cada segundo
  updateClock();
  setInterval(updateClock, 1000);

  // Cerrar modal con tecla Escape
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      const modal = document.getElementById('search-modal');
      if (modal && !modal.classList.contains('hidden')) {
        toggleModal('search-modal');
      }
    }
  });
</script>

<!-- Modal de búsqueda por placa -->
<div id="search-modal" class="fixed inset-0 bg-gray-900 bg-opacity-50 items-center flex justify-center hidden z-50" onclick="if(event.target === this) toggleModal('search-modal')">
  <div class="bg-gray-800 p-6 rounded-lg shadow-lg w-1/3" onclick="event.stopPropagation()">
    <h2 class="text-2xl font-semibold text-center text-cyan-300 mb-4" style="font-family: 'Orbitron', sans-serif;">Buscar por Placa</h2>
    <%= form_with url: search_vehicles_path, method: :get, data: { turbo_frame: "search-results-frame" }, class: "space-y-4", id: "search-form" do |form| %>
      <div>
        <%= form.text_field :plate_number, required: true, placeholder: "Ingresa el número de placa", class: "w-full mt-1 p-2 rounded-md bg-gray-700 text-white focus:ring-2 focus:ring-blue-500 focus:outline-none", id: "search-plate-input" %>
      </div>
      <div class="flex justify-center space-x-4">
        <%= form.submit "Buscar", class: "bg-green-500 hover:bg-green-600 text-white font-bold py-2 px-4 rounded-lg transition transform hover:scale-105" %>
        <% if Current.user.admin? %>
          <button type="button" onclick="exportPdf()" class="bg-purple-500 hover:bg-purple-600 text-white font-bold py-2 px-4 rounded-lg transition transform hover:scale-105">
            <i class="fa fa-file-pdf-o"></i> PDF
          </button>
        <% end %>
        <button type="button" class="bg-red-500 hover:bg-red-600 text-white font-bold py-2 px-4 rounded-lg transition transform hover:scale-105" onclick="toggleModal('search-modal')">
          Cerrar
        </button>
      </div>
    <% end %>

    <!-- Turbo Frame para los resultados -->
    <turbo-frame id="search-results-frame">
      <!-- Los resultados aparecerán aquí dinámicamente -->
      <p class="text-gray-400 text-center mt-4">Ingresa una placa para buscar resultados.</p>
    </turbo-frame>
  </div>
</div>

<script>
  function exportPdf() {
    const plateInput = document.getElementById('search-plate-input');
    const plate = plateInput.value || '';
    window.location.href = '/vehicles/export_pdf?plate_number=' + encodeURIComponent(plate);
  }
</script>
