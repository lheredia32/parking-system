<div class="container mx-auto p-6">
  <!-- Reloj digital estilo retro-futurista -->
  <div class="flex justify-center mb-4">
    <div id="digital-clock-records" class="font-mono text-5xl tracking-widest text-cyan-400 bg-gray-900 px-8 py-4 rounded-xl border-2 border-cyan-500/50 shadow-lg shadow-cyan-500/20 relative overflow-hidden">
      <span class="relative z-10">--:--:--</span>
      <div class="absolute inset-0 bg-gradient-to-r from-cyan-500/10 to-transparent"></div>
    </div>
  </div>

  <!-- Fecha -->
  <div class="text-center mb-6">
    <p id="current-date-records" class="text-lg text-gray-400 font-light tracking-widest uppercase"></p>
  </div>

  <h1 class="text-5xl font-bold text-center text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-500 to-purple-500 mb-6" style="font-family: 'Orbitron', sans-serif;">
    <i class="fa fa-list"></i> REGISTROS
  </h1>

  <div class="w-full bg-gray-800 p-6 rounded-lg shadow-lg border border-cyan-500/30">
    <!-- Formulario de búsqueda y botón "Volver" -->
    <div class="mb-6">
      <%= form_with url: records_by_user_vehicles_path, method: :get, local: true, class: "flex justify-between items-center space-x-4" do |form| %>
        <div class="flex items-center space-x-4">
          <%= form.text_field :search, value: params[:search], placeholder: "Buscar por placa", class: "w-64 p-2 rounded-md bg-gray-700 text-white placeholder-gray-400 focus:ring-2 focus:ring-cyan-500 focus:outline-none" %>
          <%= form.submit "Buscar", class: "bg-green-500 hover:bg-green-600 text-white font-bold py-2 px-4 rounded-lg transition transform hover:scale-105" %>
        </div>
        <%= link_to vehicles_path, class: "bg-gray-600 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded-lg transition transform hover:scale-105" do %>
          <i class="fa-solid fa-backward-step"></i> Volver
        <% end %>
      <% end %>
    </div>

    <!-- Título de la tabla -->
    <h2 class="text-2xl font-semibold text-center text-cyan-300 mb-6" style="font-family: 'Orbitron', sans-serif;">
      <i class="fa fa-car"></i> Registros de Vehículos
    </h2>

    <!-- Tabla de resultados -->
    <% if @vehicles&.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full bg-gray-800 text-gray-300 rounded-lg shadow-md overflow-hidden border border-cyan-500/30">
          <thead class="bg-gradient-to-r from-gray-700 to-gray-600">
            <tr>
              <th class="px-4 py-3 text-center text-sm font-semibold tracking-wider text-cyan-400">#</th>
              <th class="px-4 py-3 text-center text-sm font-semibold tracking-wider text-cyan-400">Placa</th>
              <th class="px-4 py-3 text-center text-sm font-semibold tracking-wider text-cyan-400">Tipo</th>
              <th class="px-4 py-3 text-center text-sm font-semibold tracking-wider text-cyan-400">Entrada</th>
              <th class="px-4 py-3 text-center text-sm font-semibold tracking-wider text-cyan-400">Salida</th>
              <% if Current.user.admin? %>
                <th class="px-4 py-3 text-center text-sm font-semibold tracking-wider text-cyan-400">Acciones</th>
              <% end %>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-700">
            <% @vehicles.each_with_index do |vehicle, index| %>
              <tr class="hover:bg-gray-700/50 transition-all duration-200">
                <td class="px-4 py-3 text-center font-mono text-cyan-500"><%= index + 1 %></td>
                <td class="px-4 py-3 text-center font-bold text-white"><%= vehicle.plate_number.upcase %></td>
                <td class="px-4 py-3 text-center">
                  <% case vehicle.vehicle_type
                     when 'Carro' %>
                    <span class="bg-blue-500/20 text-blue-300 px-2 py-1 rounded text-xs">Carro</span>
                  <% when 'Motocicleta' %>
                    <span class="bg-orange-500/20 text-orange-300 px-2 py-1 rounded text-xs">Motocicleta</span>
                  <% when 'Bicicleta' %>
                    <span class="bg-green-500/20 text-green-300 px-2 py-1 rounded text-xs">Bicicleta</span>
                  <% else %>
                    <span class="bg-gray-600 px-2 py-1 rounded text-xs"><%= vehicle.vehicle_type || 'N/A' %></span>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-center font-mono text-gray-400"><%= vehicle.entry_time&.strftime("%Y-%m-%d %H:%M") || "N/A" %></td>
                <td class="px-4 py-3 text-center font-mono <%= vehicle.exit_time ? 'text-green-400' : 'text-yellow-400' %>">
                  <%= vehicle.exit_time ? vehicle.exit_time.strftime("%Y-%m-%d %H:%M") : "En Parqueadero" %>
                </td>
                <% if Current.user.admin? %>
                  <td class="px-4 py-3 text-center">
                    <% if vehicle.exit_time.nil? %>
                      <%= button_to exit_vehicle_path(vehicle), method: :patch, class: "bg-yellow-500 hover:bg-yellow-600 text-white font-bold py-1 px-3 rounded-lg transition transform hover:scale-105 inline-block", title: "Registrar salida" do %>
                        <i class="fa fa-sign-out-alt"></i>
                      <% end %>
                    <% end %>
                    <%= link_to edit_vehicle_path(vehicle), class: "bg-blue-500 hover:bg-blue-600 text-white font-bold py-1 px-3 rounded-lg transition transform hover:scale-105 inline-block ml-1" do %>
                      <i class="fa fa-edit"></i>
                    <% end %>
                    <%= link_to vehicle_path(vehicle), method: :delete, data: { confirm: "¿Estás seguro?" }, class: "bg-red-500 hover:bg-red-600 text-white font-bold py-1 px-3 rounded-lg transition transform hover:scale-105 inline-block ml-1" do %>
                      <i class="fa fa-trash"></i>
                    <% end %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-12 bg-gray-800/50 rounded-lg border border-dashed border-gray-700">
        <i class="fa fa-car text-4xl text-gray-600 mb-4"></i>
        <p class="text-gray-500 text-lg">No se encontraron registros para la búsqueda "<%= params[:search] %>".</p>
      </div>
    <% end %>
  </div>

  <footer class="text-xs text-white text-center py-2 mt-8">
    &lt;/&gt; by Heredium
  </footer>
</div>

<script>
  function updateClockRecords() {
    const now = new Date();
    const hours = String(now.getHours()).padStart(2, '0');
    const minutes = String(now.getMinutes()).padStart(2, '0');
    const seconds = String(now.getSeconds()).padStart(2, '0');
    const timeString = `${hours}:${minutes}:${seconds}`;

    const clockElement = document.getElementById('digital-clock-records');
    if (clockElement) {
      clockElement.querySelector('span').textContent = timeString;
      if (parseInt(seconds) % 2 === 0) {
        clockElement.classList.add('opacity-90');
      } else {
        clockElement.classList.remove('opacity-90');
      }
    }

    const dateElement = document.getElementById('current-date-records');
    if (dateElement) {
      const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
      dateElement.textContent = now.toLocaleDateString('es-CO', options);
    }
  }

  updateClockRecords();
  setInterval(updateClockRecords, 1000);
</script>